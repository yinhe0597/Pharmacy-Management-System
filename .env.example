# 本地开发/联调环境变量样例（复制为 .env 后使用；.env 已被 .gitignore 排除）
#
# 快速生成（推荐，自动填随机值）：
#   make env-init                     # Linux / Git Bash
# Windows（无 make）可用 start.bat 生成生产 .env，或手工填写下面的变量。
#
# 说明：docker compose 已移除弱默认值，以下两项必填，缺失时 compose 会直接报错拒绝启动。
#
# 变量名口径：统一使用 YF_ 前缀。start.sh/start.bat（生产）与 Makefile（开发）读写同一套键名，
# 避免历史上 JWT_SECRET/DB_PASSWORD 与 YF_* 两套互斥命名导致「照文档配置仍启动失败」。

# JWT 签名密钥（HS256 对称密钥，≥32 字符；弱密钥/占位符会被后端启动校验拒绝）
# 生成：openssl rand -base64 48
YF_AUTH_JWT_SECRET=

# PostgreSQL 口令（本机开发可用任意强随机串；生产务必随机）
# 生成：openssl rand -hex 24
YF_DATABASE_PASSWORD=

# 前端暴露端口（生产一键部署用；开发 compose 不使用）
HTTP_PORT=80
